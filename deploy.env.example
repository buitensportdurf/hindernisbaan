# Copy to .env.deploy.local (gitignored) and fill in the secret.
#
# Primary method: DirectAdmin API over HTTPS using a scoped login key.
# Create the key in DirectAdmin: Advanced Features > Login Keys.
DEPLOY_METHOD=da-api
DEPLOY_DA_URL=https://s172.webhostingserver.nl:2222
DEPLOY_USER=deb123524
DEPLOY_DA_LOGIN_KEY=replace-me
DEPLOY_PATH=/domains/buitensportdurf.nl/public_html/hindernisbaan

# Optional overrides:
# DEPLOY_BUILD_CMD="npm run build:wp"

# FTPES fallback (requires account password; Antagonist uses explicit TLS):
# DEPLOY_METHOD=ftp
# DEPLOY_HOST=s172.webhostingserver.nl
# DEPLOY_PORT=21
# DEPLOY_PASSWORD=
# DEPLOY_FTP_SSL=true

# SSH fallback (only after enabling SSH + IP whitelist in DirectAdmin):
# DEPLOY_METHOD=ssh
# DEPLOY_HOST=s172.webhostingserver.nl
# DEPLOY_PORT=22
