# Copy to .env.deploy.local (gitignored).
#
# Deploys go over rsync/SSH. Antagonist gates SSH behind a key + IP grant:
# DirectAdmin > Extra Features > SSH menu — register the public key with your
# current IP and a 1-year expiry. Re-add the IP there whenever it changes.
# DEPLOY_HOST can be an ~/.ssh/config alias carrying the IdentityFile.
DEPLOY_HOST=buitensportdurf-deploy
DEPLOY_USER=deb123524
DEPLOY_PATH=/domains/buitensportdurf.nl/public_html/hindernisbaan

# Optional overrides:
# DEPLOY_PORT=22
# DEPLOY_BUILD_CMD="npm run build:wp"
# DEPLOY_RSYNC_FLAGS="--delete --omit-dir-times"
